{
  "app": {
    "screenshot_dir": "screenshots",
    "theme": "light",
    "show_details": false,
    "show_console": false,
    "debug_mode": true,
    "popup_scale": 92,
    "popup_opacity": 25,
    "popup_bg": "#f5f5f5",
    "popup_fg": "#202020",
    "auto_close_seconds": 0
  },
  "hotkeys": {
    "capture": "ctrl+shift+x",
    "force_exit": "ctrl+shift+l",
    "close_popup": "space",
    "exit": "ctrl+shift+q",
    "middle_click": true
  },
  "api": {
    "provider": "mistral",
    "mistral_key": "",
    "openrouter_key": "",
    "endpoint": "https://api.mistral.ai/v1/chat/completions",
    "model_id": "zai-glm-5-3-flash",
    "timeout_seconds": 60,
    "fallback_models": [
      "mistral-small-latest",
      "pixtral-12b-2409",
      "mistral-large-4"
    ],
    "use_response_schema": true,
    "retry_without_schema": true,
    "auto_fallback_on_vision_error": true,
    "max_repair_attempts": 1,
    "extra_headers": {}
  },
  "prompt": {
    "mode": "general_law",
    "prompt_file": "",
    "profiles_dir": "prompts",
    "extra_instruction": ""
  }
}
